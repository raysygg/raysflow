# 后端数据库连接，Spring Boot 会从项目根目录 .env 读取。
DB_URL=jdbc:mysql://your-mysql-host:3306/enterprise_agent?useSSL=true&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
DB_USERNAME=your_username
DB_PASSWORD=your_password

# 必须替换为随机长密钥；生产环境建议与 APP_SECRET_KEY 使用不同值。
JWT_SECRET=replace-with-a-random-jwt-secret
APP_SECRET_KEY=replace-with-a-different-random-encryption-secret

UPLOAD_DIR=data/uploads
TASK_QUEUE_POLL_DELAY_MS=1000
TASK_QUEUE_HEARTBEAT_TIMEOUT_SECONDS=120
TASK_QUEUE_RETRY_DELAY_SECONDS=30
API_RATE_LIMIT_MAX_REQUESTS=120
API_RATE_LIMIT_WINDOW_SECONDS=60
API_RATE_LIMIT_BACKEND=redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
